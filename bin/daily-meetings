#!/bin/bash
# Add today's calendar meetings to today's Obsidian daily note, as `### HH:MM Title` headings
# under `## Meetings`, with team members linked to their person notes.
#   daily-meetings                    ask Shortcuts to run the "Todays Meetings" shortcut, which
#                                     reads the calendar and hands the events back to --stdin
#   daily-meetings --saved            merge the events the shortcut saved: its last step.
#                                     --dry-run works here too
#   daily-meetings --stdin            merge events from stdin instead. Add --dry-run to print
#                                     the note, not write it
#   daily-meetings --install          run it at 11:00 on weekdays, as a user LaunchAgent
#   daily-meetings --uninstall        stop the LaunchAgent
#
# The calendar is read by a Shortcuts shortcut, because Shortcuts already has calendar access
# and needs no admin rights. The shortcut calls this script rather than the other way round:
# run by `shortcuts run`, its Find Calendar Events came back empty, while the same shortcut run
# inside Shortcuts found the meetings (2026-11-16). Opening its shortcuts:// link runs it inside
# Shortcuts. It saves every work event of the day to SAVED, then runs Run Shell Script
# `~/.zsh/bin/daily-meetings --saved` with no input. Handing the events to the shell step
# directly made Shortcuts ask "use N calendar events in a shell script?" on any day with more
# events than last approved, since "Always Allow" remembers a count, and an unattended run
# can't answer. The file is emptied once read. One block per event, attendees last; unknown
# keys are ignored:
#   @@EVENT
#   time: 16 Nov 2026 at 10:00      (start; any date format, the script finds the time)
#   end: 16 Nov 2026 at 10:30
#   allday: No
#   status: Accepted                (your response)
#   title: Weekly sync
#   attendees:
#   <one name or email per line>
# How to build it is in the vault's "Raycast Workflow" runbook.
#
# The shortcut only fetches; this script decides. It leaves out all-day events, meetings you
# declined, meetings of more than LARGE_MEETING people that you haven't accepted, and events with
# nobody else in them.
# A meeting you haven't answered, or said maybe to, is kept and marked "not answered"/"maybe".
# People are email addresses: rooms and groups, which arrive as bare names, are dropped. Team
# members (a note in the vault's People folder) are linked, colleagues sharing your email
# domain are named from it, and anyone else is only counted, so no outside address is written.
#
# Run it again as often as you like: it only appends. A meeting the note doesn't have yet gets an
# entry; nothing already in the note is changed or removed, its own earlier entries included,
# and it refuses to write if a merge would. A meeting already there as a `###` heading (or one
# shortened from the title's start) or an all-bold line isn't added again, nor is one an earlier
# run added that you have since deleted or renamed. Every run is logged, with what was left out
# and why.
set -euo pipefail

VAULT="${DAILY_MEETINGS_VAULT:-$HOME/Personal/Vault}"
# No apostrophe in the name: typed into Shortcuts it can become a curly one that never matches.
# (And bash 3.2 reads an apostrophe inside "${VAR:-…}" as opening a quote.)
SHORTCUT="${DAILY_MEETINGS_SHORTCUT:-Todays Meetings}"
LABEL="local.daily-meetings"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/daily-meetings.log"
SAVED="$HOME/Library/Caches/daily-meetings/events.txt"
# What each run added today, so a meeting you deleted or renamed isn't added back. One file,
# rewritten each run with only today's lines.
ADDED="$HOME/Library/Caches/daily-meetings/added.txt"

dry_run=0
from_saved=0
case "${1:-}" in
  --stdin) [ "${2:-}" = "--dry-run" ] && dry_run=1 ;;
  --saved) from_saved=1; [ "${2:-}" = "--dry-run" ] && dry_run=1 ;;
  --install)
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    {
      echo '<?xml version="1.0" encoding="UTF-8"?>'
      echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
      echo '<plist version="1.0"><dict>'
      echo "  <key>Label</key><string>$LABEL</string>"
      echo "  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$self</string></array>"
      echo '  <key>StartCalendarInterval</key><array>'
      for day in 1 2 3 4 5; do
        echo "    <dict><key>Weekday</key><integer>$day</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>"
      done
      echo '  </array>'
      echo "  <key>StandardOutPath</key><string>$LOG</string>"
      echo "  <key>StandardErrorPath</key><string>$LOG</string>"
      echo '</dict></plist>'
    } > "$PLIST"
    /usr/bin/plutil -lint "$PLIST" >/dev/null
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    echo "daily-meetings: runs $self at 11:00 on weekdays; log in $LOG"
    exit 0 ;;
  --uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    echo "daily-meetings: stopped. Delete $PLIST by hand to remove it for good."
    exit 0 ;;
  "")
    # -g leaves Shortcuts in the background. It runs the shortcut, which calls --stdin.
    open -g "shortcuts://run-shortcut?name=${SHORTCUT// /%20}"
    echo "daily-meetings: asked Shortcuts to run \"$SHORTCUT\""
    exit 0 ;;
  *) sed -n '2,11p' "$0"; exit 2 ;;
esac

if [ "$from_saved" = 1 ]; then
  if [ ! -s "$SAVED" ]; then
    echo "$(date '+%F %T') daily-meetings: nothing saved in $SAVED" >> "$LOG"
    echo "daily-meetings: nothing saved in $SAVED"
    exit 1
  fi
  events=$(cat "$SAVED")
  # Emptied, not deleted: the shortcut overwrites it next run. A dry run leaves it be.
  [ "$dry_run" = 1 ] || : > "$SAVED"
else
  events=$(cat)
fi

# The merge is Python, fed the events on stdin. read -d '' stops at end of input and returns 1.
read -r -d '' py <<'PY' || true
import datetime, json, os, pathlib, re, sys

LARGE_MEETING = 15  # people, you included: a bigger meeting is left out unless you accepted it
SMALL_MEETING = 4   # people besides you and the team: up to this many are all named

vault = pathlib.Path(os.environ["VAULT"])
dry_run = os.environ.get("DRY_RUN") == "1"
cfg = json.loads((vault / ".obsidian/daily-notes.json").read_text())
if cfg.get("format", "YYYY-MM-DD") != "YYYY-MM-DD":
    sys.exit("daily-meetings: only the YYYY-MM-DD daily-note format is supported")
today = datetime.date.today().isoformat()
note = vault / cfg.get("folder", "") / f"{today}.md"
tpl = cfg.get("template", "")
template = vault / (tpl if tpl.endswith(".md") else tpl + ".md") if tpl else None

def norm(s):
    return re.sub(r"[^a-z]", "", s.lower())

people = {norm(p.stem): p.stem for p in (vault / "02 Areas/Work/Team/People").glob("*.md")}
me = norm(os.environ.get("DAILY_MEETINGS_SELF", "Shaun O'Neill"))

def is_room(a):
    # "Belfast-4-C.S. Lewis (3) [Zoom Room]": a capacity in brackets, a [tag], or "room".
    return bool(re.search(r"\broom\b|\[.*\]|\(\d+\)", a, re.I))

def name_from_email(local):
    words = [w[:1].upper() + w[1:] for w in re.split(r"[._]+", local) if w]
    return " ".join("Mc" + w[2:3].upper() + w[3:] if w.lower().startswith("mc") and len(w) > 2 else w for w in words)

# A heading must start with its time. An event's time can sit anywhere: unformatted, Shortcuts
# prints a date such as "16 Nov 2026 at 10:00".
def hhmm(s, anywhere=False):
    pattern = r"(\d{1,2}):(\d{2})(?::\d{2})?\s*([AaPp][Mm])?"
    m = re.search(pattern, s or "") if anywhere else re.match(r"\s*" + pattern, s or "")
    if not m:
        return None
    h, mi, ampm = int(m.group(1)), m.group(2), (m.group(3) or "").lower()
    if ampm == "pm" and h < 12:
        h += 12
    if ampm == "am" and h == 12:
        h = 0
    return f"{h:02d}:{mi}"

# Parse the shortcut's blocks. Attendees come last, one per line.
events, cur, in_attendees = [], None, False
for line in sys.stdin.read().splitlines():
    if line.strip() == "@@EVENT":
        cur, in_attendees = {"attendees": []}, False
        events.append(cur)
    elif cur is None:
        continue
    elif in_attendees:
        if line.strip():
            cur["attendees"].append(line.strip())
    else:
        m = re.match(r"\s*(\w+):\s?(.*)$", line)
        if m and m.group(1).lower() == "attendees":
            in_attendees = True
            if m.group(2).strip():
                cur["attendees"].append(m.group(2).strip())
        elif m:
            cur[m.group(1).lower()] = m.group(2).strip()

if not events:
    # Nothing came through at all. That is a broken run as often as an empty day, so leave the
    # note alone rather than clear entries out of it.
    print(f"daily-meetings: no events from the shortcut for {today}; note left alone")
    sys.exit(0)

# Your domain is the one on your own attendee entry, so nothing about it is written here.
my_domain = next((a.partition("@")[2].lower() for e in events for a in e["attendees"]
                  if "@" in a and norm(a.partition("@")[0]) == me), None)

left_out = []   # (reason, title), for the summary and the log
unaccepted = []  # (your response, title): meetings kept without an Accepted, for the log
wanted = {}     # title.lower() -> (start, title, meta line)
for e in events:
    title = re.sub(r"\s+", " ", e.get("title", "")).strip()
    start = hhmm(e.get("time") or e.get("start"), anywhere=True)
    end = hhmm(e.get("end"), anywhere=True)
    if not title or not start or title.lower() in wanted:
        continue
    if e.get("allday", "").strip().lower() in ("yes", "true", "1"):
        left_out.append(("all-day", title))
        continue
    # Only a meeting you declined is left out. One you haven't answered, or said maybe to, goes
    # in marked, so it stands out as still needing a reply.
    status = e.get("status", "").strip()
    if "declin" in status.lower():
        left_out.append(("declined", title))
        continue
    answer = ("maybe" if re.search(r"tentat|maybe", status, re.I)
              else "not answered" if re.search(r"pend|need|not|invit", status, re.I) else None)
    team, names, outside, headcount = [], [], 0, 0
    for a in e["attendees"]:
        local, _, domain = a.partition("@")
        key = norm(local if domain else a)
        if is_room(a):
            continue
        if key == me:
            headcount += 1
        elif key in people:
            headcount += 1
            link = f"[[{people[key]}]]"
            if link not in team:
                team.append(link)
        elif not domain or re.search(r"[-0-9]", local):
            continue  # a group or resource: a bare name, or an address like dvs-eng@
        else:
            headcount += 1
            if domain.lower() != my_domain:
                outside += 1
            elif name_from_email(local) not in names:
                names.append(name_from_email(local))
    others = len(names) + outside
    if not (team or others):
        left_out.append(("no one else", title))
        continue
    # Accepting is the signal you're going, so an accepted meeting goes in whatever its size.
    # A big one you haven't accepted is usually a broadcast invite, and stays out.
    if headcount > LARGE_MEETING and status.lower() != "accepted":
        left_out.append((f"{headcount} people, {status or 'no status'}", title))
        continue
    team.sort()  # attendees arrive in a different order each run; sorted, a refresh changes nothing
    # Calendar attendees come in no fixed order, so three names picked from a big meeting say
    # nothing. A small meeting lists everyone; a bigger one shows team members and a count.
    if others <= SMALL_MEETING:
        who, rest = team + sorted(names), outside
    else:
        who, rest = list(team), others
    if rest:
        who.append(f"+{rest} other{'' if rest == 1 else 's'}" if who else f"{headcount} people")
    span = f"{start}–{end}" if end and end > start else start
    flag = f" · {answer}" if answer else ""
    wanted[title.lower()] = (start, title, f"*{span} · {', '.join(who)}{flag}*")
    if status.lower() != "accepted":
        unaccepted.append((status or "no status", title))

if note.exists():
    text = note.read_text()
elif template and template.exists():
    text = template.read_text()
else:
    text = "---\ntype: daily\ntriaged:\n---\n"
lines = text.split("\n")

def heading_title(line):
    if line.startswith("### "):
        return re.sub(r"^\d{1,2}:\d{2}\s+", "", line[4:].strip()).lower()
    m = re.match(r"^\*\*(.+?)\*\*\s*$", line)
    return m.group(1).strip().lower() if m else None

def find_section():
    s = next((i for i, l in enumerate(lines) if l.strip().lower() == "## meetings"), None)
    if s is None:
        return None, None
    e = next((i for i in range(s + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    return s, e

# Append-only: a run inserts entries for meetings the note doesn't have yet, and never changes
# or removes a line that is already there, the ones it wrote included. Checked before writing.
original = list(lines)
added = 0

# Meetings an earlier run added today. If one is no longer in the note, you deleted or renamed
# it, so it stays out.
record = pathlib.Path(os.environ["ADDED"])
added_before = set()
if record.exists():
    added_before = {t for d, _, t in (l.partition("\t") for l in record.read_text().splitlines()) if d == today}
present = {heading_title(l) for l in lines} - {None}

def in_note(title):
    # The same meeting if a heading is the title, or the title cut short from its start (a long
    # calendar title shortened by hand), or the other way round.
    k = title.lower()
    return k in present or any(len(h) >= 12 and (k.startswith(h) or h.startswith(k)) for h in present)

added_now, dismissed = [], 0
for t, title, meta in sorted(wanted.values()):
    if in_note(title):
        continue
    if title.lower() in added_before:
        dismissed += 1
        continue
    start_i, end_i = find_section()
    if start_i is None:
        # An older note: give it a Meetings section, ended by a Notes heading so what is
        # already written stays outside it.
        notes = next((i for i, l in enumerate(lines) if l.strip().lower() == "## notes"), None)
        if notes is not None:
            lines[notes:notes] = ["## Meetings", ""]
        else:
            body = 0
            if lines and lines[0] == "---":
                body = next(i for i in range(1, len(lines)) if lines[i] == "---") + 1
            lines[body:body] = ["## Meetings", "", "## Notes", ""]
        start_i, end_i = find_section()
    at = end_i
    for i in range(start_i + 1, end_i):
        ht = hhmm(lines[i][4:]) if lines[i].startswith("### ") else None
        if ht and ht > t:
            at = i
            break
    block = [f"### {t} {title}", meta, "", "- ", ""]
    if at == end_i and lines[at - 1].strip():
        block.insert(0, "")
    lines[at:at] = block
    present.add(title.lower())
    added_now.append(title.lower())
    added += 1

reasons = {}
for reason, _ in left_out:
    bucket = "large" if " people" in reason else reason
    reasons[bucket] = reasons.get(bucket, 0) + 1
changes = ", ".join(f"{n} {w}" for n, w in ((added, "added"), (dismissed, "kept out as you removed them")) if n) or "nothing new"
summary = f"daily-meetings: {today}: {changes}" + (
    " (left out " + ", ".join(f"{n} {k}" for k, n in reasons.items()) + ")" if reasons else "")
detail = [f"    left out ({reason}): {title}" for reason, title in left_out]
detail += [f"    kept ({status}): {title}" for status, title in unaccepted]

def keeps_everything(old, new):
    # Every line already in the note is still there, in the same order: old is a subsequence.
    rest = iter(new)
    return all(any(line == n for n in rest) for line in old)

if not keeps_everything(original, lines):
    sys.exit("daily-meetings: refusing to write, the merge would have changed existing lines")
out = "\n".join(lines)
if dry_run:
    print(out)
    print("\n".join([summary] + detail), file=sys.stderr)
    sys.exit(0)
if added:
    note.parent.mkdir(parents=True, exist_ok=True)
    note.write_text(out)
keep = sorted(added_before | set(added_now))
record.write_text("".join(f"{today}\t{t}\n" for t in keep))
stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
with open(os.environ["LOG"], "a") as log:
    log.write("\n".join([f"{stamp} {summary}"] + detail) + "\n")
print(summary)
PY

if [ "$dry_run" = 1 ]; then
  printf '%s\n' "$events" | VAULT="$VAULT" DRY_RUN=1 LOG=/dev/null ADDED="$ADDED" /usr/bin/python3 -I -c "$py"
  exit
fi
# The shortcut shows the summary as its result; the script logs it with the detail.
if ! summary=$(printf '%s\n' "$events" | VAULT="$VAULT" DRY_RUN=0 LOG="$LOG" ADDED="$ADDED" /usr/bin/python3 -I -c "$py" 2>&1); then
  echo "$(date '+%F %T') $summary" >> "$LOG"
  echo "$summary"
  exit 1
fi
echo "$summary"
